# API Settings
API_V1_STR=/api/v1
PROJECT_NAME="Sustainability Landing Zone Platform"

# Security
SECRET_KEY=sustainabilitylzplatformsecretkey12345
ACCESS_TOKEN_EXPIRE_MINUTES=11520

# Database
POSTGRES_SERVER=localhost
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=sustainability_lz_db

# Redis / Task Queue
REDIS_HOST=localhost
REDIS_PORT=6379

# Sustainability Config
OPTIMIZATION_THRESHOLD_PCT=15
CARBON_AWARE_SCHEDULING_ENABLED=true

# Monitoring
PROMETHEUS_METRICS_ENABLED=true
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317

# Grafana Dashboard
GRAFANA_URL=http://localhost:3000
GRAFANA_ADMIN_PASSWORD=admin
